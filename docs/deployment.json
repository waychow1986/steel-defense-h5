{
  "schemaVersion": 2,
  "services": [
    {
      "name": "web",
      "description": "钢铁防线静态网页游戏：Vite 构建产物由非 root nginx（UID 101）在 8080 端口提供，/healthz 为健康检查",
      "build": {
        "context": ".",
        "file": "Dockerfile"
      },
      "port": 8080,
      "healthPath": "/healthz",
      "exposed": true
    }
  ],
  "operations": {
    "errorLogRules": [
      {
        "name": "nginx-error",
        "kind": "pattern",
        "pattern": "\\[(?:error|crit|alert|emerg)\\] \\d+#\\d+: (?:\\*\\d+ )?(?<message>.*)",
        "severity": "high"
      },
      {
        "name": "nginx-server-5xx",
        "kind": "pattern",
        "pattern": "\"\\s(?<message>5\\d\\d)\\s\\d+\\s",
        "severity": "medium",
        "threshold": {
          "windowMinutes": 5,
          "count": 3
        }
      }
    ]
  }
}

{
  "name": "steel-defense-h5",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:integration": "playwright test -c playwright.config.ts",
    "test:e2e": "playwright test -c playwright.e2e.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.7",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitest": "^4.1.12"
  }
}
